# Never commit anything derived from the jamaat mailing list.
*.ics

# The printed taqweem is the jamaat's own published document, and it is large.
# Keep it local.
*.pdf
emails/
raw/
*.eml
.env
credentials.json
token.json
# Scheduled-task output. Carries miqaat names and times, not mail bodies,
# but there is no reason to track it.
logs/

__pycache__/
*.pyc

# Personal Hijri dates. Only the blank template is tracked.
personal/*
!personal/events.template.yaml
